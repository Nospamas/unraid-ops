# Non-secret half of the bootstrap config. The rest is secrets.sops.env.
# Both are passed with --env-file; see README.md.

TZ=America/Vancouver
KOMODO_TITLE=Komodo

# Where a browser reaches Core. Only used to suggest webhook URLs in the UI.
# Becomes https://komodo.rbrb.in once ticket 16 stands Caddy up.
# Core's identity, embedded in every alert link and in any git webhook URL it
# generates -- not an address anything dials to reach it (ticket 29).
#
# The hostname, because 26's addressing rule is that a human reaches a service
# by its *.rbrb.in name and never by the box's address: split-horizon then makes
# the same link resolve correctly from the tailnet and from rb's LAN, where a
# hardcoded IP can only ever serve one of them. `192.168.1.195` served neither
# -- it is absorbed locally on the home network and unroutable from the tailnet,
# so every alert link was dead where alerts are read.
#
# 26's "the tooling that repairs Caddy must not sit behind it" is satisfied
# separately, and better: komodo keeps :9120 bound whatever Caddy does, and
# scripts/komodo.sh dials localhost rather than this value.
#
# Caveat: rb's LAN half of this does not work yet -- see ticket 32.
KOMODO_HOST=https://komodo.rbrb.in

# The Server resource Periphery connects as. Referenced by komodo/sync.toml.
KOMODO_FIRST_SERVER_NAME=tower
