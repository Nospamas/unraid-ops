# Non-secret half of the bootstrap config. The rest is secrets.sops.env.
# Both are passed with --env-file; see README.md.

TZ=America/Vancouver
KOMODO_TITLE=Komodo

# Where a browser reaches Core. Only used to suggest webhook URLs in the UI.
# Becomes https://komodo.rbrb.in once ticket 16 stands Caddy up.
# The tailnet address, not the LAN one (ticket 29). Core embeds this in every
# alert link, and 192.168.1.195 is unroutable from the tailnet where the phone
# is, and absorbed locally on the home network whose /16 covers rb's /24 -- so
# the link was dead everywhere a notification is actually read. Not the
# `komodo.rbrb.in` hostname either: the tooling that repairs Caddy must not
# depend on it [26].
KOMODO_HOST=http://100.126.56.26:9120

# The Server resource Periphery connects as. Referenced by komodo/sync.toml.
KOMODO_FIRST_SERVER_NAME=tower
