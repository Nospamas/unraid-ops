{
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

# Ticket 05. `respond` sorts before `reverse_proxy`, so this ends the chain first.
(internal) {
	@external not remote_ip 192.168.1.0/24 100.64.0.0/10
	respond @external 403
}

# Ticket 26. The two human-facing UIs on this box that are not Stacks, so they
# have no compose file to carry a `caddy` label. Caddy is host-networked
# (ticket 16), so localhost is the box.
#
# Both keep their host port as well -- :9120 and :8008 stay bound whatever Caddy
# does, because the tooling that repairs the proxy must not sit behind it.
komodo.rbrb.in {
	import internal
	reverse_proxy localhost:9120
}

unraid.rbrb.in {
	import internal
	reverse_proxy localhost:8008
}

# Ticket 29. gatus is a Stack, but it is host-networked so it carries no
# discoverable label -- caddy-docker-proxy reads only containers on `shared`.
# It keeps :8090 for the same reason komodo and unraid keep theirs: the page
# that reports a Caddy outage must be reachable during one.
status.rbrb.in {
	import internal
	reverse_proxy localhost:8090
}

# Naming the wildcard is what makes Caddy issue one, not a cert per hostname.
*.rbrb.in {
	import internal
	respond "no service by that name" 404
}

# Ticket 37. The wildcard covers one label, so the apex matches neither this
# file's `*.rbrb.in` block nor its certificate -- hence its own block and its own
# cert, issued over the same `acme_dns cloudflare`.
#
# `route` is load-bearing: Caddy sorts `redir` *before* `respond`, so the guard
# imported outside one is emitted after the redirect and never runs. Verified by
# `caddy adapt`, not assumed.
rbrb.in {
	route {
		import internal
		redir https://home.rbrb.in{uri} 308
	}
}
