# Shared config, read by every Stack via additional_env_files.
# Values settled by ticket 09 (.scratch/unraid-gitops/issues/09-unify-uid-gid.md).
#
# PUID/PGID are 99:100 — nobody:users, Unraid's own convention. Everything on
# the box writes as this id, containers included, with no exceptions. Files
# arriving over SMB or through the Unraid file manager land the same way.
#
# UMASK=002 keeps group write on new files (664 files, 775 dirs). With every
# container on uid 99 owner-write would be enough on its own; group write is
# what keeps non-container writers interoperating.

PUID=99
PGID=100
UMASK=002
TZ=America/Vancouver

APPDATA=/mnt/user/appdata
MEDIA=/mnt/user/Media
