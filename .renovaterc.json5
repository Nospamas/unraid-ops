{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":automergeBranch",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits",
  ],
  dependencyDashboard: true,
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  schedule: ["every weekend"],
  // No versions in ciphertext.
  ignorePaths: ["**/*.sops.*"],
  // lscr.io is ghcr.io; the alias buys pagination and auth, lookup only [49].
  registryAliases: {
    "lscr.io": "ghcr.io",
  },
  packageRules: [
    {
      description: "Auto-merge mise tools",
      matchManagers: ["mise"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },

    // Only mover of a pinned tag [12]; no soak, ghcr.io serves no timestamps [58].
    {
      description: "Auto-merge container images",
      matchManagers: ["docker-compose"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: true,
    },

    // Default versioning offers nothing for -lsNNN; names are post-alias [49].
    {
      description: "linuxserver build tags — upstream version, then -lsNNN",
      matchPackageNames: [
        "ghcr.io/linuxserver/**",
        "!ghcr.io/linuxserver/qbittorrent",
        "!ghcr.io/linuxserver/lazylibrarian",
      ],
      versioning: "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+).*-ls(?<build>\\d+)$",
    },
    {
      // Three tag shapes in its history; the looser pattern rolls back five years [49].
      description: "qbittorrent — tighter anchor, three tag shapes in its history",
      matchPackageNames: ["ghcr.io/linuxserver/qbittorrent"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)[-_][^-]*-ls(?<build>\\d+)$",
    },
    {
      // Git hash and counter, no version to order by; bump by hand [49].
      description: "lazylibrarian — no version in the tag to order by",
      matchPackageNames: ["ghcr.io/linuxserver/lazylibrarian"],
      enabled: false,
    },
    {
      // TEMPORARY — delete once the backlog is drained [49].
      description: "linuxserver — first pass lands on the dashboard, not the box",
      matchPackageNames: ["ghcr.io/linuxserver/**"],
      dependencyDashboardApproval: true,
    },

    {
      // qbittorrent lives in gluetun's netns, so they never bump apart [06, 24, 29].
      description: "download stack — one PR",
      matchFileNames: ["stacks/download/**"],
      groupName: "download stack",
    },
    {
      // Nothing off-box proves a playable stream or a working Caddy [12, 29].
      description: "plex, caddy — human merge",
      matchFileNames: [
        "stacks/plex/**",
        "stacks/caddy/**",
      ],
      automerge: false,
    },
    // ntfy and gatus released to automerge: home-ops probes both off-box [29].

    // Nothing reconciles bootstrap; a human runs `just bootstrap --apply` [12].
    {
      description: "Komodo Core + Periphery bump as a pair",
      matchFileNames: ["bootstrap/**"],
      matchPackageNames: [
        "ghcr.io/moghtech/komodo-core",
        "ghcr.io/moghtech/komodo-periphery",
      ],
      groupName: "komodo",
      automerge: false,
      prBodyNotes: [
        "⚠️ **Bootstrap is not reconciled by Komodo.** Merging this changes nothing on the box.",
        "```sh",
        "just bootstrap            # what differs, and what would run",
        "just bootstrap --apply    # copy it over and recreate the containers",
        "```",
        "Core and Periphery must move together — upstream requires Periphery match Core's version before builds and clones work again.",
      ],
    },
    {
      description: "FerretDB + postgres-documentdb bump as a pair",
      matchFileNames: ["bootstrap/**"],
      matchPackageNames: [
        "ghcr.io/ferretdb/ferretdb",
        "ghcr.io/ferretdb/postgres-documentdb",
      ],
      groupName: "ferretdb",
      automerge: false,
      prBodyNotes: [
        "⚠️ **Bootstrap is not reconciled by Komodo.** Merging this changes nothing on the box.",
        "```sh",
        "just bootstrap            # what differs, and what would run",
        "just bootstrap --apply    # copy it over and recreate the containers",
        "```",
        "The `postgres-documentdb` tag names the FerretDB release it was built against, so the two must move together. Upstream warns these updates can be breaking — back up Postgres first.",
      ],
    },
  ],
}
