<?xml version="1.0"?>
<Container version="2">
  <Name>calibre</Name>
  <Repository>lscr.io/linuxserver/calibre</Repository>
  <Registry>https://github.com/orgs/linuxserver/packages/container/package/calibre</Registry>
  <Network>bridge</Network>
  <MyIP/>
