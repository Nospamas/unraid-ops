===== gluetun
image:        qmcgaw/gluetun:latest
restart:      unless-stopped
network_mode: qbittorrent_default
networks:     qbittorrent_default(ip=172.18.0.2) 
ports:        30024/tcp->:30024 6881/tcp->:6881 6881/udp->:6881 
exposed:      30024/tcp 6881/tcp 6881/udp 8000/tcp 8388/tcp 8388/udp 8888/tcp 
privileged:   false
cap_add:      [CAP_NET_ADMIN]
devices:      
cmd:          <no value>
mounts:
  bind /mnt/user/appdata/gluetun -> /gluetun (rw)
