########## 5b. WHO IS ROUTED THROUGH WHOM
plex -> bridge
qbittorrent -> /gluetun
calibre -> bridge
PortainerCE -> bridge
lazylibrarian -> bridge
prowlarr -> bridge
sonarr -> bridge
radarr -> bridge
gluetun -> qbittorrent_default

########## 8. PORTAINER STACK (qbittorrent + gluetun)
--- stack dirs:
/mnt/user/appdata/portainer/compose/:
1
2

/mnt/user/appdata/portainer/compose/1:
docker-compose.yml

/mnt/user/appdata/portainer/compose/2:
docker-compose.yml
--- stack files:
===== /mnt/user/appdata/portainer/compose/1/docker-compose.yml
services:
  plex:
    image: lscr.io/linuxserver/plex:latest # Set specific: plexinc/pms-docker:1.40.2.8395-c67dce28e
    container_name: plex
    network_mode: bridge # Change this to 'bridge' to define ports, example ports below
    ports:
      - 32400:32400/tcp
      #- 8324:8324/tcp
      #- 32469:32469/tcp
      #- 1900:1900/udp
      #- 32410:32410/udp
      #- 32412:32412/udp
      #- 32413:32413/udp
      #- 32414:32414/udp
    # Uncomment the devices section for tv tuners and intel gpus
    devices:
      #- /dev/dvb:/dev/dvb # Uncomment this device for typical USB TV Tuner cards
      - /dev/dri:/dev/dri # Uncomment this to use intel GPUs for Hardware Transcoding
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/Vancouver # Change this to match your server's timezone
      - PLEX_CLAIM=<<REDACTED — needs a secret>> # Uncomment this to setup Plex server, get your claim code from here - https://www.plex.tv/claim/
      - VERSION=1.43.1.10495-10cfae054
      - PLEX_DOWNLOAD=https://downloads.plex.tv/plex-media-server-builds
      # Uncomment the lines below to use Nvidia GPUs for Hardware Transcoding
      #- NVIDIA_VISIBLE_DEVICES=all
      #- NVIDIA_DRIVER_CAPABILITIES=all
    volumes:
      - /etc/localtime:/etc/localtime:ro # Sync the container's time to the host's time
      - /mnt/user/appdata/plexmediaserver:/config # Plex server application data is stored in a folder called 'plexmediaserver' in the same directory as the docker-compose.yaml file
      # Uncomment the lines below for each library,
      # make sure the path on the left of the colon (:) exists on the host! `/mnt/tv`
      - /mnt/user/Media/tv:/mnt/tv
      - /mnt/user/Media/movies:/mnt/movies
      - /mnt/user/Media/music-rb:/mnt/music-rb
      - /mnt/user/Media/music-reg:/mnt/music-reg
      - /mnt/user/Media/podcasts:/mnt/podcasts
      - /mnt/user/appdata/transcode:/mnt/transcode
    restart: unless-stopped===== /mnt/user/appdata/portainer/compose/2/docker-compose.yml
version: "3.8"

services:
  gluetun:
    image: qmcgaw/gluetun:latest
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    ports:
      - "${GLUETUN_WEBUI_PORT:-30024}:30024"   # WebUI port
      - "${TORRENT_TCP_PORT:-6881}:6881/tcp"   # Torrent TCP
      - "${TORRENT_UDP_PORT:-6881}:6881/udp"   # Torrent UDP
    environment:
      VPN_SERVICE_PROVIDER: "nordvpn"
      VPN_TYPE: "wireguard"
      WIREGUARD_PRIVATE_KEY: "<<REDACTED — needs a secret>>"
      SERVER_HOSTNAMES: "us8240.nordvpn.com"
      SERVER_COUNTRIES: "United States"
      SERVER_CITIES: "Seattle"
      TZ: "America/Vancouver"
      FIREWALL_VPN_INPUT_ALLOW: "192.168.1.0"
      FIREWALL_OUTBOUND_SUBNET: "0.0.0.0/0"
      VPN_WAIT: "on"
      VPN_WAIT_TIME: "60s"
    volumes:
      - /mnt/user/appdata/gluetun:/gluetun
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"

  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    environment:
      PUID: "${PUID:-1001}"
      PGID: "${PGID:-1001}"
      TZ: "${TZ:-UTC}"
      WEBUI_PORT: "${GLUETUN_WEBUI_PORT:-30024}"
      TORRENTING_PORT: "${TORRENT_TCP_PORT:-6881}"
    network_mode: "service:gluetun"   # shares Gluetun network
    volumes:
      - /mnt/user/appdata/qbittorrent:/config
      - /mnt/user/Media/downloads:/downloads
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
